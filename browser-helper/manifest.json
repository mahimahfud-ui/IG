{
  "manifest_version": 3,
  "name": "Mahi Instagram Helper",
  "version": "2.2.0",
  "description": "Browser-session Instagram helper for the Mahi Control Center.",
  "host_permissions": ["https://www.instagram.com/*"],
  "permissions": ["activeTab","storage","tabs"],
  "action": {"default_title":"Mahi Instagram Helper","default_popup":"popup.html"},
  "background": {"service_worker":"background.js"},
  "content_scripts": [{"matches":["https://www.instagram.com/*"],"js":["content.js"],"run_at":"document_idle"}],
  "externally_connectable": {"matches":["https://mahi-ig-control.onrender.com/*"]},
  "homepage_url":"https://github.com/mahimahfud-ui/IG",
  "key":""
}