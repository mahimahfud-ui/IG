{
  "manifest_version": 3,
  "name": "Mahi Instagram Helper",
  "version": "1.3.0",
  "description": "Privacy-first Instagram utility dashboard using the browser session you already have open.",
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_title": "Mahi Instagram Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://mahi-unliker.onrender.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.3.0 · Web Session Bridge",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "homepage_url": "https://github.com/mahimahfud-ui/IG",
  "background": {
    "service_worker": "background.js"
  }
}
