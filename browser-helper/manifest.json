{
  "manifest_version": 3,
  "name": "Mahi Instagram Helper",
  "version": "2.0.1",
  "description": "Standalone Instagram utility dashboard using your existing signed-in browser session.",
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_title": "Mahi Instagram Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "2.0.1 · Web Session Header Fix",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "homepage_url": "https://github.com/mahimahfud-ui/IG"
}
