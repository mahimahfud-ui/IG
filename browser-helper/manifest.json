{
  "manifest_version": 3,
  "name": "Browser Tools",
  "version": "2.2.0",
  "description": "Browser-session Instagram helper for the Social Media Tools dashboard.",
  "host_permissions": ["https://www.instagram.com/*","https://mahicloud.onrender.com/*"],
  "permissions": ["activeTab","storage","tabs"],
  "action": {"default_title":"Browser Tools","default_popup":"popup.html"},
  "background": {"service_worker":"background.js"},
  "content_scripts": [
    {"matches":["https://www.instagram.com/*"],"js":["content.js"],"run_at":"document_idle"},
    {"matches":["https://mahicloud.onrender.com/instagram-cleaner.html"],"js":["dashboard-bridge.js"],"run_at":"document_idle"}
  ],
  "externally_connectable": {"matches":["https://mahi-ig-control.onrender.com/*"]},
  "homepage_url":"https://mahicloud.onrender.com/instagram-cleaner.html",
  "key":""
}